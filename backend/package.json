{
  "name": "@trazacafe/backend",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "node --import tsx src/server.ts",
    "migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "crear-cooperativa": "node --env-file-if-exists=.env --import tsx scripts/crear-cooperativa.ts",
    "crear-tecnico": "node --env-file-if-exists=.env --import tsx scripts/crear-tecnico.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@trazacafe/eudr-eas-schemas": "*",
    "fastify": "^5.0.0",
    "firebase-admin": "^13.0.0",
    "pg": "^8.13.0",
    "tsx": "^4.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
