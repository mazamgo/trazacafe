# --- Base de datos: elige UNA de las dos opciones ---

# A) Cloud SQL con autenticación IAM (sin contraseñas). Requiere una vez:
#    gcloud auth application-default login
INSTANCE_CONNECTION_NAME=trazacafe-dev:us-east4:trazacafe-dev-instance
DB_NAME=trazacafe-dev-database
# Tu correo de Google (debe existir como usuario IAM de la instancia)
DB_USER=

# B) Cualquier PostgreSQL con PostGIS (local, Neon...). Deja vacía la opción A.
# DATABASE_URL=postgres://usuario:clave@host:5432/base

# Puerto local (Cloud Run lo define solo)
PORT=8080

# Proyecto de Firebase para validar los tokens de inicio de sesión
FIREBASE_PROJECT_ID=trazacafe-dev

# Bucket de Firebase Storage donde la app sube las fotos (la API las verifica y borra)
STORAGE_BUCKET=trazacafe-dev.firebasestorage.app

# --- Tareas programadas (Cloud Scheduler) ---
# La API solo acepta el token OIDC de esta cuenta, emitido para esta URL.
# En local se pueden dejar vacías: las tareas responden 401.
TAREAS_AUDIENCE=
TAREAS_SA=

# --- Chequeo satelital ---
# Vacío = mapas públicos (JRC 2020 + Hansen), sin cuentas ni keys.
# SATELITE=gfw (modo combinado) usa los mismos mapas y suma las alertas
# integradas de Global Forest Watch; necesita GFW_API_KEY. Si GFW falla, el
# resultado sale solo de los mapas.
# SATELITE=gfw
# GFW_API_KEY=

# --- Attestations (EAS en OP) ---
# Versión de la clave de firma en Cloud KMS. Vacía = la API no firma nada.
# También la usa `npm run registrar-esquemas`.
KMS_KEY_VERSION=projects/trazacafe-dev/locations/us-east4/keyRings/trazacafe/cryptoKeys/atestador/cryptoKeyVersions/1
# optimism-sepolia (pruebas) u optimism (OP Mainnet)
EAS_RED=optimism-sepolia
# RPC propio (opcional). Vacío = el público de la red elegida.
# RPC_URL=
