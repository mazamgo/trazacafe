# --- Base de datos: elige UNA de las dos opciones ---

# A) Cloud SQL con autenticación IAM (sin contraseñas). Requiere una vez:
#    gcloud auth application-default login
INSTANCE_CONNECTION_NAME=trazacafe-dev:us-east4:trazacafe-dev-instance
DB_NAME=trazacafe-dev-database
# Tu correo de Google (debe existir como usuario IAM de la instancia)
DB_USER=

# B) Cualquier PostgreSQL con PostGIS (local, Neon...). Deja vacía la opción A.
# DATABASE_URL=postgres://usuario:clave@host:5432/base

# Puerto local (Cloud Run lo define solo)
PORT=8080

# Proyecto de Firebase para validar los tokens de inicio de sesión
FIREBASE_PROJECT_ID=trazacafe-dev
