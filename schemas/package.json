{
  "name": "@trazacafe/eudr-eas-schemas",
  "version": "0.1.0",
  "description": "Esquemas EAS para trazabilidad EUDR (finca, entrega, lote, exportación) en el OP Stack",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schemas.json": "./schemas.json",
    "./test-vectors.json": "./test-vectors.json",
    "./fixtures/*": "./fixtures/*"
  },
  "scripts": {
    "register": "node --env-file-if-exists=.env --import tsx scripts/register.ts",
    "vectors": "tsx scripts/vectors.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@turf/area": "^7.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
